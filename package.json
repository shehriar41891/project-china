{
  "name": "deep-playground-prototype",
  "version": "2016.3.10",
  "description": "",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build:client": "cd client && npm run build",
    "dev": "npm run prep && concurrently \"--kill-others=false\" \"node server.js\" \"npm run watch\"",
    "start": "npm run prep && node server.js",
    "prep": "npm run build:client && copyfiles -f client/public/* dist && copyfiles editor.html playground.html analytics.js guide-and-drag.js editor.css node-editor.js dist && concat node_modules/material-design-lite/material.min.js node_modules/seedrandom/seedrandom.min.js > dist/lib.js",
    "build-css": "concat node_modules/material-design-lite/material.min.css styles.css > dist/bundle.css",
    "watch-css": "concat node_modules/material-design-lite/material.min.css styles.css -o dist/bundle.css",
    "build-html": "copyfiles playground.html editor.html dist",
    "watch-html": "copyfiles playground.html editor.html dist",
    "build-js": "browserify src/playground.ts -p [tsify] | uglifyjs -c > dist/bundle.js",
    "watch-js": "watchify src/playground.ts -p [tsify] -v --debug -o dist/bundle.js",
    "build": "npm run prep && npm run build-js && npm run build-css && npm run build-html",
    "watch": "npm run prep && concurrently \"npm run watch-js\" \"npm run watch-css\" \"npm run watch-html\"",
    "serve": "npx serve dist/",
    "serve-watch": "concurrently \"npx serve dist/\" \"npm run watch\"",
    "server": "node server.js",
    "dev:db": "concurrently \"npm run watch\" \"node server.js\""
  },
  "devDependencies": {
    "@types/d3": "^3.5.34",
    "browserify": "^17.0.0",
    "concat": "^1.0.3",
    "concurrently": "3.1.0",
    "copyfiles": "1.0.0",
    "rimraf": "2.5.4",
    "serve": "^11.3.0",
    "tsify": "^4.0.0",
    "typescript": "^2.9",
    "uglify-js": "^2.8.29",
    "watchify": "^4.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "cookie-parser": "^1.4.6",
    "d3": "^3.5.16",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "material-design-lite": "^1.3.0",
    "seedrandom": "^2.4.3",
    "session-file-store": "^1.5.0"
  }
}
